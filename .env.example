# Anthropic API key for Claude (required)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL connection string for credits/user database (required for Streamlit app)
CREDITS_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Public URL of the deployed app (used in invite links)
APP_URL=https://memochef.streamlit.app

# College House SQL (StudentResearch) — live comp & market performance.
# Optional: leave unset to disable. Requires pyodbc + an MS ODBC driver.
# Server/database/driver defaults match the standard Subtext research server,
# so usually only the username and password are needed.
COLLEGEHOUSE_SQL_SERVER=subtextresearch.database.windows.net
COLLEGEHOUSE_SQL_DATABASE=StudentResearch
COLLEGEHOUSE_SQL_USERNAME=your-username
COLLEGEHOUSE_SQL_PASSWORD=your-password
COLLEGEHOUSE_SQL_DRIVER=ODBC Driver 17 for SQL Server
