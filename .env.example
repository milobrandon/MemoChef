# Anthropic API key for Claude (required)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL connection string for credits/user database (required for Streamlit app)
CREDITS_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Resend email API key for invite emails (optional)
# Get your key at https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the deployed app (used in invite emails)
APP_URL=https://your-app.streamlit.app

# Sender address for outbound emails
RESEND_FROM=Memo Chef <noreply@yourdomain.com>
