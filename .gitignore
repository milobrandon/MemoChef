# Environment / secrets
.env
.streamlit/secrets.toml
.streamlit/secrets_deploy.toml

# Example memos (large proprietary files)
managed_agents/examples/*.pptx

# Managed agents live test artifacts (local dev only)
test_output_managed_agents/
test_api_live.py
test_managed_agents_live.py

# Per-org custom-skill ID cache (populated by sync_skills.py).
# Each Anthropic org gets different skill_* IDs, so this must not be
# committed — it would leak IDs and conflict across deployments.
managed_agents/.skills.json

# Stray Streamlit session logs (from rolled-back runs)
rollback*.log

# Python
__pycache__/
*.pyc
*.pyo
.coverage
htmlcov/

# Output artifacts
output/
run_artifacts/
*.bak

# Uploaded data files
*.pptx
*.xlsm

# OS files
Thumbs.db
.DS_Store
~$*

# Ad-hoc analysis / one-off scripts
analyze_memos.py
compare_formatting.py
deep_table_compare.py
extract_chart_colors.py
limestone_analysis.json
template_analysis.json

