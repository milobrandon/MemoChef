# Required Streamlit secrets for Memo Chef
# Copy this file to secrets.toml and fill in real values.
# NEVER commit secrets.toml to version control.
#
# Generate password hashes with:
#   python -c "from app_helpers import hash_password; print(hash_password('your-password'))"

ANTHROPIC_API_KEY = "sk-ant-..."
CREDITS_DATABASE_URL = "postgresql://user:password@host/neondb?sslmode=require"
RESEND_API_KEY = "re_..."
APP_URL = "https://your-app.streamlit.app"
RESEND_FROM = "Memo Chef <noreply@yourdomain.com>"

[users.brandon]
password_hash = "salt_hex:hash_hex"
role = "admin"
credits_per_week = 20

[users.john]
password_hash = "salt_hex:hash_hex"
role = "user"
credits_per_week = 5
